# Copy to .env and fill in. NEVER commit .env.

# ── Required (HTTP mode) ─────────────────────────────────────────────────────
# Public HTTPS URL of this server (e.g. your Cloudflare Tunnel hostname).
BASE_URL=https://brkbowl.example.com

# Password for the OAuth consent page that Claude / VS Code open when connecting.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=replace_with_a_long_random_password

# 32-byte key (64 hex chars) that encrypts the saved Berkeley Bowl session.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it just means you log in with a new SMS code.
SESSION_ENCRYPTION_KEY=replace_with_64_hex_chars

# ── Optional ─────────────────────────────────────────────────────────────────
# Static bearer token for clients that cannot do OAuth (scripts, VS Code mcp.json).
# MCP_BEARER_TOKEN=

# Default phone number for login_start, e.g. (555) 010-0000
# BB_PHONE=

# Defaults used when the agent does not specify a store or produce preference.
# DEFAULT_STORE=west
# DEFAULT_PRODUCE_PREFERENCE=conventional

# Extra hosts allowed as OAuth redirect targets (comma-separated), on top of
# claude.ai, claude.com, vscode.dev and localhost.
# ALLOWED_REDIRECT_HOSTS=

# CATALOG_TTL_HOURS=12
# PORT=3000
# DATA_DIR=/data
# LOG_LEVEL=info

# Cloudflare Tunnel token (cloudflared sidecar in docker-compose.yml)
# CLOUDFLARE_TUNNEL_TOKEN=

# Homesome API base URL and public site key (defaults are correct for Berkeley Bowl)
# HS_BASE_URL=https://user-api.gethomesome.com
# HS_API_KEY=
